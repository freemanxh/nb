1.1 服务端配置
/etc/wireguard/wg0.conf

[Interface]
Address    = 172.19.239.253/24, fd42:42:42::1/64   # 服务器在虚拟网内的地址
ListenPort = 58491                                  # UDP 端口
PrivateKey = <服务器私钥>

# 启动时自动加的防火墙 / NAT 规则
PostUp = iptables -I INPUT -p udp --dport 58491 -j ACCEPT
PostUp = iptables -I FORWARD -i eth0 -o wg0 -j ACCEPT
PostUp = iptables -I FORWARD -i wg0 -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
# （PostDown 为对应的删除规则）

