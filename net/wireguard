命令速查
# ---------- 服务端 ----------
sudo wg show                              # 查看所有 peer、握手时间、流量
sudo wg show wg0 transfer                 # 只看流量统计
sudo systemctl status  wg-quick@wg0       # 服务状态
sudo systemctl restart wg-quick@wg0       # 重启（改完配置后执行）
sudo wg set wg0 peer <公钥> remove        # 吊销客户端
sudo wg-quick save wg0                    # 把运行时改动持久化
sudo ss -ulmn sport = :58491              # 查看 UDP socket 缓冲实况
ss -lunp | grep 58491                     # 确认 UDP 监听

# ---------- Linux 客户端 ----------
sudo wg-quick up   wg0                    # 连接
sudo wg-quick down wg0                    # 断开
sudo wg show                              # 握手状态
ip route | grep wg0                       # 查看 VPN 路由（验证分流）
curl -s ifconfig.me                       # 当前出口 IP

# ---------- 性能 ----------
sysctl net.core.rmem_max net.core.wmem_max          # 查看缓冲上限
cat /etc/sysctl.d/99-wireguard-tuning.conf          # 查看已写入的优化
sudo rm /etc/sysctl.d/99-wireguard-tuning.conf && sudo sysctl --system   # 回滚优化
ip -s link show wg0                                  # 查看 wg0 错误/丢包计数

# ---------- 排障 ----------
sudo journalctl -u wg-quick@wg0 -n 50     # 服务日志
sudo wg show wg0 latest-handshakes        # 握手时间戳（0 = 从未成功）
sudo tcpdump -i eth0 udp port 58491 -n    # 服务端抓包




