windows 客户端
1. 自动生成peer
curl -O https://raw.githubusercontent.com/angristan/wireguard-install/master/wireguard-install.sh
chmod +x wireguard-install.sh
sudo ./wireguard-install.sh
# 选 "1) Add a new user"，名字输 company_win
# 自动生成 /home/xuhui/wg0-client-company_win.conf，并直接打印二维码


2. 手动生成
# 生成客户端密钥
wg genkey | tee client.key | wg pubkey > client.pub
wg genpsk > client.psk

# 加入服务端
sudo wg set wg0 peer $(cat client.pub) preshared-key client.psk allowed-ips 172.19.239.4/32
sudo wg-quick save wg0        # 持久化，否则重启丢失


3. 导入配置
[Interface]
PrivateKey = <不动>
Address    = 172.19.239.4/32
# DNS      = 100.100.2.136, 100.100.2.138     ← 注释掉，否则公司电脑会断网
MTU        = 1380                              ← 新增

[Peer]
PublicKey    = Cn1B58aIaycgraWTEmuxdRlP0VLiX+HjlPWNCMsGOTg=
PresharedKey = <不动>
Endpoint     = 101.37.81.235:58491
AllowedIPs   = 172.19.239.0/24                 ← 改这里，别用 0.0.0.0/0
PersistentKeepalive = 25                        ← 新增


4. 验证
ping 172.19.239.253                    # 应通
curl.exe -s ifconfig.me                # 应显示公司出口 IP（证明分流生效）
start http://172.19.239.253:6638       # 打开 ComfyUI


