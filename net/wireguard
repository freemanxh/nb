Ubuntu 客户端

1. 安装
sudo apt update
sudo apt install -y wireguard wireguard-tools resolvconf

2. 取配置文件
scp -P 6632 xuhui@101.37.81.235:/home/xuhui/wg0-client-company_pc.conf ./

3. 关键修改——全局改分流
[Interface]
PrivateKey = <保持不动>
Address    = 172.19.239.2/32, fd42:42:42::2/128
# DNS      = 100.100.2.136, 100.100.2.138     ← ① 注释掉
MTU        = 1380                              ← ④ 新增（见第七章）

[Peer]
PublicKey    = Cn1B58aIaycgraWTEmuxdRlP0VLiX+HjlPWNCMsGOTg=
PresharedKey = <保持不动>
Endpoint     = 101.37.81.235:58491
AllowedIPs   = 172.19.239.0/24                ← ② 由 0.0.0.0/0, ::/0 改成这个
PersistentKeepalive = 25                      ← ③ 新增

4. 客户端性能优化
sudo tee /etc/sysctl.d/99-wireguard-client.conf <<'EOF'
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
EOF
sudo sysctl -p /etc/sysctl.d/99-wireguard-client.conf

5.安装并启动
sudo cp wg0-client-company_pc.conf /etc/wireguard/wg0.conf
sudo chmod 600 /etc/wireguard/wg0.conf        # 含私钥，必须锁权限

sudo wg-quick up wg0        # 启动
sudo wg-quick down wg0      # 停止
sudo systemctl enable --now wg-quick@wg0

6. 验证
sudo wg show                          # ① 出现 latest handshake 即成功
ping -c 3 172.19.239.253              # ② 连通性
curl -s ifconfig.me ; echo            # ③ 应显示公司出口 IP，非 101.37.81.235（证明分流生效）
curl -I http://172.19.239.253:6638/   # ④ 访问 ComfyUI

