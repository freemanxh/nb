#!/bin/bash 
set -euo pipefail  # 增加安全检查：遇错停止、未定义变量报错

if [ $# -lt 2 ]; then
        echo "用法: $0 <continue|build|all> <域名>" >&2
        exit 1
fi


action="$1"
url_name="$2"

case "$action" in 
        continue|build|all)
                ;;
        *)

        echo "错误:第一个参数必须是continue,build或all,收到:'$action'" >&2
        exit 1
        ;;
esac
echo "$url_name"

SSL_DIR="/home/yematech/ssl/${url_name}"

# 1. 签发证书（去掉 --force，让 acme.sh 自动管理续期）
# 如果是首次运行或确实需要强制重签，再手动加 --force
if [[ "$action" == "continue" || "$action" == "all" ]]; then
~/.acme.sh/acme.sh --issue --force \
    --dns dns_ali \
    -d "${url_name}" \
    -d "*.${url_name}"
fi

# 2. 创建目录（安全方式，无需 rm -rf）
mkdir -p "${SSL_DIR}"

# 3. 安装证书并自动重载 Nginx
~/.acme.sh/acme.sh --install-cert \
    -d "${url_name}" \
    -d "*.${url_name}" \
    --key-file       "${SSL_DIR}/key.pem" \
    --cert-file      "${SSL_DIR}/cert.pem" \
    --fullchain-file "${SSL_DIR}/fullchain.pem" 
    #--reloadcmd      "nginx -s reload"  # ← 关键：确保证书生效后服务自动重载
openssl x509 -noout -dates -in ${SSL_DIR}/cert.pem
#echo "✅ SSL 证书已更新: ${SSL_DIR}"
