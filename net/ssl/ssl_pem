4、安装多个证书，并分发，重启
#!/bin/bash
DOMAINS=("yematech.cc" "yematech.cn" "smarte.cc" "smarte.tech" "yemaland.cn")
BASE_DIR="/home/yematech"

REMOTE_IP=("192.168.0.60")
REMOTE_DIR="/data/ssl"

for domain in "${DOMAINS[@]}"; do
        echo "install $domain ing..."
        mkdir -p "$BASE_DIR/ssl/$domain"
$BASE_DIR/.acme.sh/acme.sh --install-cert -d $domain -d *.$domain \
        --key-file $BASE_DIR/ssl/$domain/key.pem \
        --cert-file $BASE_DIR/ssl/$domain/cert.pem \
        --fullchain-file $BASE_DIR/ssl/$domain/fullchain.pem

        echo "$domain installed successfully!"
done

for remote_ip in "${REMOTE_IP[@]}"; do
        echo "copy to $remote_ip"
        for domain in "${DOMAINS[@]}"; do
                echo "copy $domain"
                scp -r $BASE_DIR/ssl/$domain root@$remote_ip:$REMOTE_DIR/
                ssh root@$remote_ip "chmod 444 $REMOTE_DIR/$domain/*"
                ssh root@$remote_ip "chmod 400 $REMOTE_DIR/$domain/key.pem"
        done
        ssh root@$remote_ip "docker restart nginx"
done

echo "...the end..."

